import { Theme } from "theme.slint";

export component Knob inherits Rectangle {
    in-out property <float> value: 0.5;
    in property <string> label: "";
    in property <color> accent: Theme.text-secondary;
    in property <bool> show-db: true;
    callback changed(float);

    width: 48px;
    height: 64px;
    background: transparent;

    property <float> drag-start-y: 0;
    property <float> drag-start-value: 0.5;
    property <bool> dragging: false;
    property <bool> fine: false;

    VerticalLayout {
        spacing: 2px;
        alignment: center;

        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 20px;
            border-width: 1.5px;
            border-color: Theme.border;
            background: Theme.elevated;

            Rectangle {
                width: 2px;
                height: 6px;
                x: (parent.width - self.width) / 2;
                y: 3px;
                background: Theme.text-secondary.with-alpha(0.7);
            }

            Text {
                text: show-db ? (value < 0.02 ? "-∞" : round((value - 0.5) * 12) + "dB") : round(value * 100);
                color: Theme.text-secondary;
                font-size: 9px;
                font-family: "Segoe UI";
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: label;
            color: Theme.text-secondary;
            font-size: 9px;
            font-family: "Segoe UI";
            horizontal-alignment: center;
        }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.fine = event.modifiers.shift;
                root.dragging = true;
                root.drag-start-y = self.mouse-y / 1px;
                root.drag-start-value = root.value;
            }
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.dragging = false;
            }
        }
        moved => {
            if (self.pressed && root.dragging) {
                root.value = max(0.0, min(1.0, root.drag-start-value + (root.drag-start-y - self.mouse-y / 1px) / (root.fine ? 240.0 : 80.0)));
                root.changed(root.value);
            }
        }
        double-clicked => {
            root.value = 0.5;
            root.changed(root.value);
        }
    }
}

export component Fader inherits Rectangle {
    in-out property <float> value: 1.0;
    in property <color> accent: Theme.text-secondary;
    callback changed(float);

    width: 28px;
    height: 140px;
    background: Theme.elevated;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;

    Rectangle {
        width: 4px;
        height: parent.height - 12px;
        x: (parent.width - self.width) / 2;
        y: 6px;
        background: Theme.border;
        border-radius: 2px;
    }

    Rectangle {
        width: 18px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: 6px + (1.0 - root.value) * (parent.height - 22px);
        background: accent;
        border-radius: 2px;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        moved => {
            if (self.pressed) {
                root.value = max(0.0, min(1.0, 1.0 - (self.mouse-y / 1px - 6.0) / (parent.height / 1px - 22.0)));
                root.changed(root.value);
            }
        }
    }
}

export component Crossfader inherits Rectangle {
    in-out property <float> value: 0.5;
    callback changed(float);

    height: 32px;
    background: Theme.elevated;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;

    Rectangle {
        width: parent.width - 16px;
        height: 3px;
        x: 8px;
        y: (parent.height - self.height) / 2;
        background: Theme.border;
        border-radius: 1.5px;
    }

    Rectangle {
        width: 14px;
        height: 20px;
        x: 8px + root.value * (parent.width - 30px);
        y: (parent.height - self.height) / 2;
        background: Theme.text-primary;
        border-radius: 3px;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        moved => {
            if (self.pressed) {
                root.value = max(0.0, min(1.0, (self.mouse-x / 1px - 8.0) / (parent.width / 1px - 30.0)));
                root.changed(root.value);
            }
        }
        double-clicked => {
            root.value = 0.5;
            root.changed(root.value);
        }
    }
}

export component MeterBar inherits Rectangle {
    in property <float> level: 0.0;
    in property <bool> clipping: false;
    width: 8px;
    height: 100px;
    background: Theme.elevated;
    border-radius: 2px;

    Rectangle {
        width: parent.width;
        height: max(0px, parent.height * level);
        y: parent.height - self.height;
        background: clipping ? Theme.error : Theme.synced;
        border-radius: 2px;
    }
}

export component TransportButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    in property <color> accent: Theme.text-primary;
    in property <bool> enabled: true;
    callback clicked;

    height: 28px;
    min-width: 48px;
    border-radius: 4px;
    border-width: 1px;
    border-color: active ? accent : Theme.border;
    background: active ? #343941 : Theme.elevated;
    opacity: enabled ? 1.0 : 0.45;

    Text {
        text: label;
        color: active ? accent : Theme.text-primary;
        font-size: 11px;
        font-family: "Segoe UI";
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component KillButton inherits Rectangle {
    in property <string> label: "K";
    in property <bool> active: false;
    in property <color> accent: Theme.error;
    callback toggled;

    width: 22px;
    height: 18px;
    border-radius: 3px;
    border-width: 1px;
    border-color: active ? accent : Theme.border;
    background: active ? accent.with-alpha(0.25) : Theme.elevated;

    Text {
        text: label;
        color: active ? accent : Theme.text-secondary;
        font-size: 9px;
        font-weight: 700;
        font-family: "Segoe UI";
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.toggled(); }
    }
}

export component HotCuePad inherits Rectangle {
    in property <int> slot: 0;
    in property <bool> set: false;
    in property <color> accent: Theme.deck-a;
    in property <bool> enabled: true;
    callback triggered(int, bool);

    width: 28px;
    height: 22px;
    border-radius: 3px;
    border-width: 1px;
    border-color: set ? accent : Theme.border;
    background: set ? accent.with-alpha(0.3) : Theme.elevated;
    opacity: enabled ? 1.0 : 0.4;

    Text {
        text: slot + 1;
        color: set ? accent : Theme.text-secondary;
        font-size: 10px;
        font-weight: 700;
        font-family: "Segoe UI";
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                root.triggered(root.slot, event.modifiers.shift);
            }
        }
    }
}
