import { Theme } from "theme.slint";

export component SettingsPanel inherits Rectangle {
    in property <bool> open: false;
    in property <[string]> devices: [];
    in property <int> master-device-index: 0;
    in property <int> cue-device-index: -1;
    in property <string> sample-rate-text: "48000";
    in property <string> buffer-text: "256";
    in property <string> crossfader-curve: "Equal Power";
    in property <bool> load-protection: true;
    in property <bool> cue-available: false;
    in property <string> status-message: "";

    callback close();
    callback master-device-changed(int);
    callback cue-device-changed(int);
    callback toggle-load-protection();
    callback cycle-crossfader-curve();

    width: 100%;
    height: 100%;
    background: #000000.with-alpha(0.55);
    visible: root.open;

    Rectangle {
        width: min(560px, parent.width - 80px);
        height: min(480px, parent.height - 80px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.panel;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                Text {
                    text: "SETTINGS";
                    color: Theme.text-primary;
                    font-size: 16px;
                    font-weight: 700;
                    font-family: "Segoe UI";
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 4px;
                    background: Theme.elevated;
                    Text { text: "✕"; color: Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.close(); } }
                }
            }

            Text { text: "AUDIO"; color: Theme.text-secondary; font-size: 11px; font-weight: 700; font-family: "Segoe UI"; }
            Text { text: "Backend: WASAPI (ASIO not redistributed in this build)"; color: Theme.text-secondary; font-size: 11px; font-family: "Segoe UI"; }
            Text { text: "Sample rate: " + sample-rate-text + "   Buffer: " + buffer-text; color: Theme.text-primary; font-size: 12px; font-family: "Segoe UI"; }

            Text { text: "Master device index: " + master-device-index; color: Theme.text-primary; font-size: 12px; font-family: "Segoe UI"; }
            Text { text: cue-available ? "Cue device available — select a second output for headphones." : "No separate cue output — cue is not mixed into master."; color: cue-available ? Theme.synced : Theme.warning; font-size: 11px; font-family: "Segoe UI"; wrap: word-wrap; }

            Text { text: "PERFORMANCE"; color: Theme.text-secondary; font-size: 11px; font-weight: 700; font-family: "Segoe UI"; }
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    height: 28px;
                    min-width: 140px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.elevated;
                    Text { text: "Load protection: " + (load-protection ? "ON" : "OFF"); color: Theme.text-primary; font-size: 11px; font-family: "Segoe UI"; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.toggle-load-protection(); } }
                }
                Rectangle {
                    height: 28px;
                    min-width: 160px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.elevated;
                    Text { text: "Crossfader: " + crossfader-curve; color: Theme.text-primary; font-size: 11px; font-family: "Segoe UI"; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.cycle-crossfader-curve(); } }
                }
            }

            Text { text: "ABOUT"; color: Theme.text-secondary; font-size: 11px; font-weight: 700; font-family: "Segoe UI"; }
            Text {
                text: "ArcLive DJ — native Rust. UI powered by Slint (https://slint.dev).";
                color: Theme.text-secondary;
                font-size: 11px;
                font-family: "Segoe UI";
                wrap: word-wrap;
            }

            if status-message != "": Text {
                text: status-message;
                color: Theme.warning;
                font-size: 11px;
                font-family: "Segoe UI";
                wrap: word-wrap;
            }

            Rectangle { vertical-stretch: 1; background: transparent; }
        }
    }

    TouchArea {
        clicked => { root.close(); }
    }
}